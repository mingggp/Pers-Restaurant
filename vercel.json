{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/kitchen",
      "dest": "/kitchen.html"
    },
    {
      "src": "/owner",
      "dest": "/owner.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
