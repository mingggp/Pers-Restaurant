# ============================================================
# Per's Restaurant — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────
# Local example:  postgresql://postgres:password@localhost:5432/pers_restaurant
# Supabase/Neon:  postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/pers_restaurant
DATABASE_SSL=false    # set to true for cloud DBs (Supabase, Neon, RDS, etc.)

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d         # customer token lifetime
JWT_STAFF_EXPIRES_IN=12h  # staff token lifetime

# ── LINE Login ───────────────────────────────────────────────
# 1. Go to https://developers.line.biz/console/
# 2. Create a provider → Create a "LINE Login" channel
# 3. In "LINE Login" tab, add callback URL: http://localhost:4000/auth/line/callback
# 4. Copy Channel ID and Channel Secret below
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REDIRECT_URI=http://localhost:4000/auth/line/callback

# ── Frontend ─────────────────────────────────────────────────
# Where to redirect after LINE Login success
FRONTEND_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Cloudinary (image storage) ───────────────────────────────
# ถ้าตั้ง 3 ค่านี้ครบ → upload จะใช้ Cloudinary
# ถ้าไม่ตั้ง → fallback ไปเก็บ local disk (backend/uploads/)
# สมัครฟรีที่ https://cloudinary.com (25GB storage + 25GB bandwidth/เดือน)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
